# console.anthropic.com 에서 발급받은 API 키를 넣어주세요.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사용할 모델. 비워두면 claude-sonnet-5가 기본값이에요.
# 더 빠르고 저렴하게 쓰고 싶다면 claude-haiku-4-5-20251001 로 바꿔보세요.
# ANTHROPIC_MODEL=claude-sonnet-5

# (선택) 프론트엔드가 다른 도메인에 있을 때만 설정하세요. 기본값은 전체 허용(*)입니다.
# CORS_ORIGIN=https://your-site.com

# (선택) server.js를 쓸 때 로컬 포트 지정 (기본 3000)
# PORT=3000
